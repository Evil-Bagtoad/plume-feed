   "license": "CC BY-SA 4.0",
   "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
   "revision": "https://fr.vikidia.org/w/index.php?title=Tour_Eiffel&oldid=2566903",
   "retrieved": "2026-09-30",
   "note": "The first and last paragraphs of the introduction. No words were changed.",
   "blocks": [
    {
     "p": [
      {
       "fr": "La tour Eiffel est une tour en fer située sur le Champ de Mars, à Paris, en France.",
       "en": "The Eiffel Tower is an iron tower on the Champ de Mars, in Paris, in France."
      },
      {
       "fr": "Elle doit son nom à l'ingénieur Gustave Eiffel, qui en est le créateur.",
       "en": "It is named after the engineer Gustave Eiffel, who created it."
      },
      {
       "fr": "Elle a été inaugurée le 31 mars 1889, lors de l'Exposition universelle qui se déroulait à Paris la même année.",
       "en": "It opened on 31 March 1889, during the World's Fair that took place in Paris that same year."
      },
      {
       "fr": "Sa hauteur est de 330 mètres, en comptant les antennes disposées à son sommet.",
       "en": "It is 330 metres tall, counting the antennas at its top."
      }
     ]
    },
    {
     "p": [
      {
       "fr": "La tour Eiffel est considérée comme le symbole de Paris et de la France.",
       "en": "The Eiffel Tower is seen as the symbol of Paris and of France."
      },
      {
       "fr": "Elle est le monument payant le plus visité au monde, avec près de 7 millions de visiteurs chaque année.",
       "en": "It is the most visited paid monument in the world, with almost 7 million visitors every year."
      }
     ]
    }
   ],
