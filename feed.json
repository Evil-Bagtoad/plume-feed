   "revision": "https://fr.vikidia.org/w/index.php?title=Chat&action=history",
   "retrieved": "2026-09-30",
   "note": "Shortened from the article's introduction. Whole sentences and parentheses were removed and marked […]. No words were changed.",
   "blocks": [
    {
     "p": [
      {
       "fr": "Le chat domestique […] est un mammifère carnivore de la famille des félidés […].",
       "en": "The house cat is a meat-eating mammal from the cat family."
      },
      {
       "fr": "C'est le seul félin domestiqué […].",
       "en": "It is the only tamed wild cat."
      }
     ]
    },
    {
     "p": [
      {
       "fr": "Les chats sont de grands dormeurs : les jeunes chats, appelés chatons, dorment jusqu'à 13 heures par jour.",
       "en": "Cats are big sleepers: young cats, called kittens, sleep up to 13 hours a day."
      },
      {
       "fr": "Les chats font leur toilette, c'est-à-dire qu'ils se lavent en se léchant grâce à une langue râpeuse.",
       "en": "Cats groom themselves, that is, they wash themselves by licking, thanks to a rough tongue."
      }
     ]
    },
    {
     "p": [
      {
       "fr": "Les chats ont une très bonne vision dans le noir grâce à leur pupille qui se dilate bien plus que celle de l'humain.",
       "en": "Cats see very well in the dark thanks to their pupil, which opens much wider than a human's."
      }
     ]
    }
   ],
   "quiz": [
    {
     "q": "Les jeunes chats s'appellent des ___.",
     "options": [
      "chiots",
      "chatons",
      "félins"
     ],
     "answer": 1,
     "why": "« les jeunes chats, appelés chatons »"
    },
    {
     "q": "Les jeunes chats dorment jusqu'à ___ heures par jour.",
     "options": [
      "8",
      "13",
      "20"
     ],
     "answer": 1,
     "why": "« dorment jusqu'à 13 heures par jour »"
    },
    {
     "q": "Comment les chats se lavent-ils ?",
     "options": [
      "Ils se lèchent.",
      "Ils nagent.",
      "Ils dorment."
     ],
     "answer": 0,
     "why": "« ils se lavent en se léchant »"
    }
   ],
