  {
   "id": "vikidia-chat",
   "title": "Chat",
   "title_en": "Cat",
   "emoji": "🐈",
   "color": "#e9bd72",
   "topic": "Animaux",
   "level": "A2",
   "kind": "excerpt",
   "source": "Vikidia, l'encyclopédie des 8-13 ans",
