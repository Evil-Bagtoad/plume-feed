  {
   "id": "vikidia-chien",
   "title": "Chien",
   "title_en": "Dog",
   "emoji": "🐕",
   "color": "#9fc6a8",
   "topic": "Animaux",
   "level": "A2",
   "kind": "excerpt",
   "source": "Vikidia, l'encyclopédie des 8-13 ans",
   "source_url": "https://fr.vikidia.org/wiki/Chien",
   "author": "Vikidia contributors",
   "license": "CC BY-SA 4.0",
   "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
   "revision": "https://fr.vikidia.org/w/index.php?title=Chien&oldid=2567701",
   "retrieved": "2026-09-30",
   "note": "Shortened from the article's introduction. Removed parts are marked […]. No words were changed.",
   "blocks": [
    {
     "p": [
      {
       "fr": "Le chien […] est un mammifère carnivore (c'est-à-dire qui ne mange que de la viande) […].",
       "en": "The dog is a meat-eating mammal (that is, it only eats meat)."
      },
      {
       "fr": "La femelle du chien s'appelle « chienne » et le petit « chiot ».",
       "en": "The female dog is called a \"chienne\" and the baby a \"chiot\" (puppy)."
      }
     ]
    },
    {
     "p": [
      {
       "fr": "C'est aussi le plus ancien animal domestique, de nos jours souvent utilisé comme simple animal de compagnie et considéré comme le meilleur ami de l'homme.",
       "en": "It is also the oldest tame animal. Today it is often just a pet, and it is seen as man's best friend."
      }
     ]
    },
    {
     "p": [
      {
       "fr": "Il a un très bon flair et peut être dressé.",
       "en": "It has a very good sense of smell and can be trained."
      },
      {
       "fr": "Il existe plus de 350 races de chiens, comme le beauceron, le husky sibérien, le berger allemand, le border collie, le bichon havanais […].",
       "en": "There are more than 350 dog breeds, like the Beauceron, the Siberian Husky, the German Shepherd, the Border Collie, the Havanese…"
      }
     ]
    }
   ],
   "quiz": [
    {
     "q": "Le petit du chien s'appelle un ___.",
     "options": [
      "chiot",
      "chaton",
      "loup"
     ],
     "answer": 0,
     "why": "« le petit « chiot » »"
    },
    {
     "q": "Le chien est considéré comme le meilleur ___ de l'homme.",
     "options": [
      "animal",
      "ami",
      "flair"
     ],
     "answer": 1,
     "why": "« le meilleur ami de l'homme »"
    },
